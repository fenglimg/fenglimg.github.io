---
layout: null
sitemap: false
---
[
{%- for p in site.posts -%}
  {"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"date":"{{ p.date | date: '%Y-%m-%d' }}","tags":{{ p.tags | jsonify }},"desc":{{ p.description | default: p.excerpt | strip_html | strip_newlines | truncate: 120 | jsonify }},"content":{{ p.content | strip_html | strip_newlines | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
